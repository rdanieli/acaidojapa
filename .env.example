# ============================================
# Acai do Japa - Environment Variables
# Copy to .env and fill in the values
# ============================================

# Database
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Dashboard Auth
DASHBOARD_USER=admin
DASHBOARD_PASS=CHANGE_ME
JWT_SECRET=CHANGE_ME_RANDOM_STRING

# PDV Legal / Tablet Cloud
PDV_API_URL=https://api.tabletcloud.com.br
PDV_USERNAME=
PDV_PASSWORD=
PDV_CLIENT_ID=
PDV_CLIENT_SECRET=
PDV_COD_FILIAL=

# Cardapio Web
CARDAPIO_TOKEN=
CARDAPIO_API_URL=https://integracao.cardapioweb.com

# Cron Secret (for daily stock processing)
CRON_SECRET=CHANGE_ME_RANDOM_STRING

# GitHub Container Registry (for pulling dashboard image)
GHCR_TOKEN=

# Groq AI (free — https://console.groq.com/keys)
GROQ_API_KEY=

# Evolution API
EVOLUTION_API_KEY=CHANGE_ME_RANDOM_STRING
EVOLUTION_SERVER_URL=https://evolution.yourdomain.com
EVOLUTION_INSTANCE_NAME=acaidojapa

# WhatsApp Version (update if connection fails — check https://web.whatsapp.com/check-update?version=0&platform=web)
WA_VERSION=2.3000.1035194821
